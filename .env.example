# TypeSafe API Key for Jev
TYPESAFE_API_KEY=your_typesafe_api_key_here

# TypeSafe model (e.g. jev-latest or jev-preview)
TYPESAFE_MODEL=jev-latest

# Optional: Default AI decision interval in milliseconds (e.g., 250)
AI_DECISION_INTERVAL_MS=250

# Optional: Default game mode: human, jev, heuristic
DEFAULT_MODE=human
